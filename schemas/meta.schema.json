{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ter-mar.dev/schemas/meta.schema.json",
  "title": "meta.json",
  "description": "Provenance and model parameters. Every other emitted file is uninterpretable without this one.",
  "type": "object",
  "required": [
    "schema", "model_version", "generated_at", "datasus_extracted_at",
    "ibge_vintage", "window", "suppression", "verdict_alpha",
    "reference_model", "views"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "meta/1.0.0" },
    "model_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "datasus_extracted_at": {
      "description": "DATASUS revises past competencias. Without this date two runs are not comparable.",
      "type": "string", "format": "date"
    },
    "ibge_vintage": { "type": "string", "pattern": "^[0-9]{4}$" },
    "window": {
      "type": "object",
      "required": ["start", "end", "label"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "suppression": {
      "type": "object",
      "required": ["min_expected_deaths", "min_stays"],
      "additionalProperties": false,
      "properties": {
        "min_expected_deaths": { "type": "number", "exclusiveMinimum": 0 },
        "min_stays": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "verdict_alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
    "reference_model": {
      "type": "object",
      "required": ["kind", "c_statistic", "strata_count"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["stratified", "logistic"] },
        "c_statistic": {
          "description": "Expect 0.75-0.80. Above 0.85 on this data indicates outcome leakage.",
          "type": "number", "minimum": 0.5, "maximum": 1
        },
        "strata_count": { "type": "integer", "minimum": 1 },
        "collapsed_strata": { "type": "integer", "minimum": 0 }
      }
    },
    "views": {
      "type": "object",
      "required": ["residence", "provider"],
      "additionalProperties": false,
      "properties": {
        "residence": { "$ref": "#/$defs/view" },
        "provider": { "$ref": "#/$defs/view" }
      }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "required": ["phi", "prior", "municipalities_total", "municipalities_published", "expected_false_flags"],
      "additionalProperties": false,
      "properties": {
        "phi": { "type": "number", "minimum": 0 },
        "prior": {
          "type": "object",
          "required": ["alpha", "nu", "s2_clamped"],
          "additionalProperties": false,
          "properties": {
            "alpha": { "type": "number", "exclusiveMinimum": 0 },
            "nu": { "type": "number", "exclusiveMinimum": 0 },
            "s2_clamped": {
              "description": "True when the moment estimate of s2 was non-positive and had to be clamped.",
              "type": "boolean"
            }
          }
        },
        "municipalities_total": { "type": "integer", "minimum": 0 },
        "municipalities_published": { "type": "integer", "minimum": 0 },
        "expected_false_flags": { "type": "number", "minimum": 0 }
      }
    }
  }
}
