{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ter-mar.dev/schemas/municipios.schema.json",
  "title": "municipios.json",
  "description": "One entry per municipality in scope, sorted by code ascending. Never sorted by an outcome field (invariant 6).",
  "type": "object",
  "required": [
    "schema",
    "municipalities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "municipios/1.0.0"
    },
    "municipalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/municipality"
      }
    }
  },
  "$defs": {
    "verdict": {
      "enum": [
        "within",
        "above",
        "below",
        "insufficient"
      ]
    },
    "confidenceInterval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      ]
    },
    "residence": {
      "allOf": [
        {
          "$ref": "#/$defs/outcomeFields"
        },
        {
          "$ref": "#/$defs/suppressionRule"
        }
      ],
      "required": [
        "stays_per_100k",
        "treated_outside_pct"
      ],
      "properties": {
        "stays_per_100k": {
          "type": "number",
          "minimum": 0
        },
        "treated_outside_pct": {
          "description": "Share of this municipality's residents' ICU stays that happened in another municipality.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "unevaluatedProperties": false
    },
    "provider": {
      "allOf": [
        {
          "$ref": "#/$defs/outcomeFields"
        },
        {
          "$ref": "#/$defs/suppressionRule"
        },
        {
          "$ref": "#/$defs/noIcuRule"
        }
      ],
      "required": [
        "has_icu",
        "icu_beds",
        "icu_beds_per_100k",
        "from_other_municipalities_pct"
      ],
      "properties": {
        "has_icu": {
          "type": "boolean"
        },
        "icu_beds": {
          "type": "integer",
          "minimum": 0
        },
        "icu_beds_per_100k": {
          "type": "number",
          "minimum": 0
        },
        "from_other_municipalities_pct": {
          "description": "Share of stays in this municipality's establishments whose patients live elsewhere.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "unevaluatedProperties": false
    },
    "municipality": {
      "type": "object",
      "required": [
        "code",
        "name",
        "uf",
        "health_region",
        "population",
        "residence",
        "provider",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "7-digit IBGE code. The 6-digit SIH form never leaves the pipeline.",
          "type": "integer",
          "minimum": 1000000,
          "maximum": 9999999
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uf": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "health_region": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "integer",
          "minimum": 0
        },
        "residence": {
          "$ref": "#/$defs/residence"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "private_coverage_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "outcomeFields": {
      "description": "Field list shared by both views. The conditional rules that enforce invariant 3 live in suppressionRule, applied as a sibling so that a failure reports the offending field rather than an unevaluated-property error.",
      "type": "object",
      "required": [
        "stays",
        "observed_deaths",
        "expected_deaths",
        "smr",
        "smr_ci",
        "p_value",
        "verdict",
        "suppressed"
      ],
      "properties": {
        "stays": {
          "type": "integer",
          "minimum": 0
        },
        "observed_deaths": {
          "type": "integer",
          "minimum": 0
        },
        "expected_deaths": {
          "type": "number",
          "minimum": 0
        },
        "smr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "smr_ci": {
          "$ref": "#/$defs/confidenceInterval"
        },
        "p_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "suppressed": {
          "type": "boolean"
        }
      }
    },
    "suppressionRule": {
      "description": "Invariant 3: a suppressed estimate is null, never renderable.",
      "allOf": [
        {
          "if": {
            "properties": {
              "suppressed": {
                "const": true
              }
            },
            "required": [
              "suppressed"
            ]
          },
          "then": {
            "properties": {
              "smr": {
                "type": "null"
              },
              "smr_ci": {
                "type": "null"
              },
              "p_value": {
                "type": "null"
              },
              "verdict": {
                "const": "insufficient"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "suppressed": {
                "const": false
              }
            },
            "required": [
              "suppressed"
            ]
          },
          "then": {
            "properties": {
              "smr": {
                "type": "number"
              },
              "smr_ci": {
                "type": "array"
              },
              "p_value": {
                "type": "number"
              },
              "verdict": {
                "enum": [
                  "within",
                  "above",
                  "below"
                ]
              }
            }
          }
        }
      ]
    },
    "noIcuRule": {
      "description": "A municipality with no ICU reports no beds and is suppressed.",
      "if": {
        "properties": {
          "has_icu": {
            "const": false
          }
        },
        "required": [
          "has_icu"
        ]
      },
      "then": {
        "properties": {
          "icu_beds": {
            "const": 0
          },
          "suppressed": {
            "const": true
          }
        }
      }
    }
  }
}
